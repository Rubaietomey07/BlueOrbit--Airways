<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinemanagementsystem.controllers.PassengerManagementController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #2c3e50; -fx-padding: 16 24 16 24;">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="BlueOrbit Airways"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Passenger Management"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white;
                           -fx-border-color: rgba(255,255,255,0.4);
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- Add / Update Passenger -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Add / Update Passenger"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <HBox spacing="12">
                        <VBox spacing="4">
                            <Label text="Full Name"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <TextField fx:id="nameField"
                                       promptText="Full name" prefWidth="200"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Username"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <TextField fx:id="usernameField"
                                       promptText="Username" prefWidth="150"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Password"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <TextField fx:id="passwordField"
                                       promptText="Password" prefWidth="150"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="formMessageLabel" text=""
                           style="-fx-font-size: 13px;" wrapText="true"/>

                    <HBox spacing="12">
                        <Button text="Add Passenger" onAction="#handleAdd"
                                style="-fx-background-color: #1a73e8;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                        <Button text="Update Selected" onAction="#handleUpdate"
                                style="-fx-background-color: #f39c12;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                        <Button text="Clear" onAction="#handleClear"
                                style="-fx-background-color: #95a5a6;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                    </HBox>

                </VBox>

                <!-- Search Passengers -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Search Passengers"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Search by name or username"
                                   prefWidth="300"/>
                        <Button text="Search" onAction="#handleSearch"
                                style="-fx-background-color: #1a73e8;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                        <Button text="Show All" onAction="#handleShowAll"
                                style="-fx-background-color: #95a5a6;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                    </HBox>

                    <TableView fx:id="passengersTable" prefHeight="200">
                        <columns>
                            <TableColumn fx:id="colUserId"   text="ID"       prefWidth="60"/>
                            <TableColumn fx:id="colName"     text="Name"     prefWidth="180"/>
                            <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
                            <TableColumn fx:id="colStatus"   text="Status"   prefWidth="100"/>
                        </columns>
                    </TableView>

                    <Label fx:id="tableMessageLabel" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                </VBox>

                <!-- Change / Upgrade Seat -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Change / Upgrade Passenger Seat"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Booking ID"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <TextField fx:id="changeBookingIdField"
                                       promptText="e.g. 1 or BKG-1"
                                       prefWidth="150"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="New Seat Class"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <ComboBox fx:id="newClassCombo"
                                      promptText="Select class"
                                      prefWidth="150"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="New Seat Number"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <ComboBox fx:id="newSeatCombo"
                                      promptText="Select seat"
                                      prefWidth="150"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text=" " style="-fx-font-size: 13px;"/>
                            <Button text="Load Seats" onAction="#handleLoadSeats"
                                    style="-fx-background-color: #95a5a6;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;
                                           -fx-padding: 8 12 8 12;"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text=" " style="-fx-font-size: 13px;"/>
                            <Button text="Change Seat" onAction="#handleChangeSeat"
                                    style="-fx-background-color: #8e44ad;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 6;
                                           -fx-cursor: hand;
                                           -fx-padding: 8 12 8 12;"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="changeSeatMessageLabel" text=""
                           style="-fx-font-size: 13px;" wrapText="true"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>