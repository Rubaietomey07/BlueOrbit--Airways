<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinemanagementsystem.controllers.PaymentController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #1a73e8; -fx-padding: 16 24 16 24;">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="BlueOrbit Airways"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Payment"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white;
                           -fx-border-color: rgba(255,255,255,0.4);
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- Total Amount Card -->
                <VBox spacing="8"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">
                    <Label text="Total Amount Payable"
                           style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                    <Label fx:id="totalAmountLabel" text="BDT 0.00"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a73e8;"/>
                </VBox>

                <!-- Payment Method Card -->
                <VBox spacing="14"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Select Payment Method"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <HBox spacing="16">
                        <VBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #e0e0e0;
                                     -fx-border-radius: 8;
                                     -fx-padding: 16;"
                              prefWidth="150">
                            <Label text="Bank Account"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #333;"/>
                            <RadioButton fx:id="bankRadio" text="Select"
                                         onAction="#handleMethodSelection"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #e0e0e0;
                                     -fx-border-radius: 8;
                                     -fx-padding: 16;"
                              prefWidth="150">
                            <Label text="Card"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #333;"/>
                            <RadioButton fx:id="cardRadio" text="Select"
                                         onAction="#handleMethodSelection"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: #f8f9fa;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #e0e0e0;
                                     -fx-border-radius: 8;
                                     -fx-padding: 16;"
                              prefWidth="150">
                            <Label text="Bkash"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #333;"/>
                            <RadioButton fx:id="bkashRadio" text="Select"
                                         onAction="#handleMethodSelection"/>
                        </VBox>
                    </HBox>

                </VBox>

                <!-- Account Details Card -->
                <VBox fx:id="accountDetailsBox" spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label fx:id="accountTypeLabel" text="Enter Account Details"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <VBox spacing="4">
                        <Label fx:id="accountNumberLabel" text="Account Number"
                               style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <TextField fx:id="accountNumberField"
                                   promptText="Enter account/card/bkash number"
                                   prefWidth="300"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="PIN"
                               style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                        <PasswordField fx:id="pinField"
                                       promptText="Enter PIN"
                                       prefWidth="300"/>
                    </VBox>

                    <Separator/>

                    <Label fx:id="paymentMessageLabel" text=""
                           style="-fx-font-size: 13px;" wrapText="true"/>

                </VBox>

                <!-- Pay Button -->
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 0 20 0;">
                    <Button text="Confirm Payment →"
                            onAction="#handlePayment"
                            style="-fx-background-color: #27ae60;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 6;
                                   -fx-font-size: 14px;
                                   -fx-cursor: hand;
                                   -fx-padding: 10 20 10 20;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>