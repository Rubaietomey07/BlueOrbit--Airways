<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinemanagementsystem.controllers.UserManagementController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #922b21; -fx-padding: 16 24 16 24;">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="BlueOrbit Airways"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="User Management"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white;
                           -fx-border-color: rgba(255,255,255,0.4);
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- Search + Actions -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Manage Users"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <!-- Search -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Search by name or username"
                                   prefWidth="280"/>
                        <Button text="Search" onAction="#handleSearch"
                                style="-fx-background-color: #1a73e8;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                        <Button text="Show All" onAction="#handleShowAll"
                                style="-fx-background-color: #95a5a6;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 6;
                                       -fx-cursor: hand;
                                       -fx-padding: 8 16 8 16;"/>
                    </HBox>

                    <!-- Users Table -->
                    <TableView fx:id="usersTable" prefHeight="300">
                        <columns>
                            <TableColumn fx:id="colId"       text="ID"         prefWidth="50"/>
                            <TableColumn fx:id="colName"     text="Name"       prefWidth="160"/>
                            <TableColumn fx:id="colUsername" text="Username"   prefWidth="130"/>
                            <TableColumn fx:id="colRole"     text="Role"       prefWidth="80"/>
                            <TableColumn fx:id="colStatus"   text="Status"     prefWidth="80"/>
                            <TableColumn fx:id="colCreated"  text="Created At" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <Label fx:id="tableMessageLabel" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                </VBox>

                <!-- Actions Card -->
                <VBox spacing="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #e0e0e0;
                             -fx-border-radius: 12;
                             -fx-padding: 24;">

                    <Label text="Actions for Selected User"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #333;"/>

                    <Label fx:id="selectedUserLabel"
                           text="No user selected — click a row above"
                           style="-fx-font-size: 13px; -fx-text-fill: #888;"/>

                    <HBox spacing="16" alignment="CENTER_LEFT">

                        <!-- Assign Role -->
                        <VBox spacing="6">
                            <Label text="Assign Role"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <HBox spacing="8">
                                <ComboBox fx:id="roleCombo"
                                          prefWidth="140" promptText="Select role"/>
                                <Button text="Assign Role"
                                        onAction="#handleAssignRole"
                                        style="-fx-background-color: #1a73e8;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 6;
                                               -fx-cursor: hand;
                                               -fx-padding: 8 12 8 12;"/>
                            </HBox>
                        </VBox>

                        <!-- Activate / Deactivate -->
                        <VBox spacing="6">
                            <Label text="Account Status"
                                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
                            <HBox spacing="8">
                                <Button text="Activate"
                                        onAction="#handleActivate"
                                        style="-fx-background-color: #27ae60;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 6;
                                               -fx-cursor: hand;
                                               -fx-padding: 8 12 8 12;"/>
                                <Button text="Deactivate"
                                        onAction="#handleDeactivate"
                                        style="-fx-background-color: #e74c3c;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 6;
                                               -fx-cursor: hand;
                                               -fx-padding: 8 12 8 12;"/>
                            </HBox>
                        </VBox>

                    </HBox>

                    <Label fx:id="actionMessageLabel" text=""
                           style="-fx-font-size: 13px;" wrapText="true"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>