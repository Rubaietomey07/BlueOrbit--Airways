<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinemanagementsystem.controllers.ReportsController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #922b21; -fx-padding: 16 24 16 24;">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="BlueOrbit Airways"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="Reports"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: rgba(255,255,255,0.85);"/>
            </VBox>
            <Button text="← Back" onAction="#goBack"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white;
                           -fx-border-color: rgba(255,255,255,0.4);
                           -fx-border-radius: 6;
                           -fx-background-radius: 6;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 30;">

                <!-- Summary Stats -->
                <HBox spacing="16">
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color: #1a73e8;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;"
                          prefWidth="160">
                        <Label fx:id="confirmedLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="Confirmed Bookings"
                               style="-fx-font-size: 12px; -fx-text-fill: white;"
                               wrapText="true"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color: #e74c3c;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;"
                          prefWidth="160">
                        <Label fx:id="cancelledLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="Cancelled Bookings"
                               style="-fx-font-size: 12px; -fx-text-fill: white;"
                               wrapText="true"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color: #27ae60;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;"
                          prefWidth="160">
                        <Label fx:id="revenueLabel" text="BDT 0"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="Total Revenue"
                               style="-fx-font-size: 12px; -fx-text-fill: white;"
                               wrapText="true"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color: #8e44ad;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;"
                          prefWidth="160">
                        <Label fx:id="passengersLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="Total Passengers"
                               style="-fx-font-size: 12px; -fx-text-fill: white;"
                               wrapText="true"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color: #f39c12;
                                 -fx-background-radius: 10;
                                 -fx-padding: 16;"
                          prefWidth="160">
                        <Label fx:id="flightsLabel" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>
                        <Label text="Total Flights"
                               style="-fx-font-size: 12px; -fx-text-fill: white;"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Tabs for different reports -->
                <TabPane fx:id="reportTabs"
                         style="-fx-background-color: white;
                                -fx-background-radius: 12;">

                    <!-- Booking Report Tab -->
                    <Tab text="Booking Report" closable="false">
                        <VBox spacing="8" style="-fx-padding: 16;">
                            <TableView fx:id="bookingTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="bColId"      text="ID"       prefWidth="50"/>
                                    <TableColumn fx:id="bColName"    text="Passenger" prefWidth="120"/>
                                    <TableColumn fx:id="bColFlight"  text="Flight"   prefWidth="80"/>
                                    <TableColumn fx:id="bColRoute"   text="Route"    prefWidth="150"/>
                                    <TableColumn fx:id="bColDate"    text="Date"     prefWidth="100"/>
                                    <TableColumn fx:id="bColSeat"    text="Seat"     prefWidth="60"/>
                                    <TableColumn fx:id="bColClass"   text="Class"    prefWidth="80"/>
                                    <TableColumn fx:id="bColStatus"  text="Status"   prefWidth="90"/>
                                </columns>
                            </TableView>
                            <Label fx:id="bookingCountLabel" text=""
                                   style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
                        </VBox>
                    </Tab>

                    <!-- Revenue Report Tab -->
                    <Tab text="Revenue Report" closable="false">
                        <VBox spacing="8" style="-fx-padding: 16;">
                            <TableView fx:id="revenueTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="rColFlight"   text="Flight"   prefWidth="90"/>
                                    <TableColumn fx:id="rColRoute"    text="Route"    prefWidth="170"/>
                                    <TableColumn fx:id="rColDate"     text="Date"     prefWidth="100"/>
                                    <TableColumn fx:id="rColBookings" text="Bookings" prefWidth="80"/>
                                    <TableColumn fx:id="rColRevenue"  text="Revenue"  prefWidth="120"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Passenger Report Tab -->
                    <Tab text="Passenger Report" closable="false">
                        <VBox spacing="8" style="-fx-padding: 16;">
                            <TableView fx:id="passengerTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="pColId"        text="ID"        prefWidth="60"/>
                                    <TableColumn fx:id="pColName"      text="Name"      prefWidth="160"/>
                                    <TableColumn fx:id="pColUsername"  text="Username"  prefWidth="130"/>
                                    <TableColumn fx:id="pColTotal"     text="Total"     prefWidth="70"/>
                                    <TableColumn fx:id="pColConfirmed" text="Confirmed" prefWidth="90"/>
                                    <TableColumn fx:id="pColCancelled" text="Cancelled" prefWidth="90"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </TabPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>