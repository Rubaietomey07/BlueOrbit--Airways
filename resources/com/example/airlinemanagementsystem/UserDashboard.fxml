<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.airlinemanagementsystem.controllers.UserDashboardController"
            prefWidth="900" prefHeight="600">

    <center>
        <StackPane>

            <!-- Background Image -->
            <ImageView fitWidth="900" fitHeight="600" preserveRatio="false">
                <image>
                    <Image url="@dashboard_bg.png"/>
                </image>
            </ImageView>

            <!-- Content on top of image -->
            <VBox spacing="0">

                <!-- Top Navigation Bar -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-padding: 16 28 16 28;
                             -fx-background-color: rgba(15,45,90,0.45);">

                    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="✈"
                               style="-fx-font-size: 22px; -fx-text-fill: white;
                                      -fx-font-weight: bold;"/>
                        <VBox spacing="0">
                            <Label text="BLUEORBIT"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: white;"/>
                            <Label text="AIRWAYS"
                                   style="-fx-font-size: 8px;
                                          -fx-text-fill: rgba(255,255,255,0.6);"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14" alignment="CENTER">
                        <Label fx:id="welcomeLabel" text="Welcome back!"
                               style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                        <StackPane>
                            <Circle radius="18" fill="rgba(255,255,255,0.2)"
                                    stroke="rgba(255,255,255,0.5)" strokeWidth="1.5"/>
                            <Label text="👤" style="-fx-font-size: 16px;"/>
                        </StackPane>
                        <Button text="⬚  Logout" onAction="#handleLogout"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: white;
                                       -fx-border-color: rgba(255,255,255,0.6);
                                       -fx-border-radius: 20;
                                       -fx-background-radius: 20;
                                       -fx-font-size: 13px;
                                       -fx-cursor: hand;
                                       -fx-padding: 6 18 6 14;"/>
                    </HBox>
                </HBox>

                <!-- Center Content -->
                <VBox alignment="CENTER" spacing="28" VBox.vgrow="ALWAYS"
                      style="-fx-padding: 80 0 0 0;">

                    <Label text="What would you like to do?"
                           style="-fx-font-size: 16px;
                                  -fx-text-fill: rgba(255,255,255,0.9);"/>

                    <HBox spacing="24" alignment="CENTER">

                        <!-- Search & Book -->
                        <VBox alignment="CENTER" spacing="12"
                              onMouseClicked="#goToSearchFlight"
                              style="-fx-background-color: rgba(255,255,255,0.95);
                                     -fx-background-radius: 18;
                                     -fx-padding: 36 28 36 28;
                                     -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.18),12,0,0,4);"
                              prefWidth="200" prefHeight="180">
                            <Label text="✈"
                                   style="-fx-font-size: 34px; -fx-text-fill: #1a2d5a;"/>
                            <Label text="Search &amp; Book"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a2d5a;"/>
                            <Label text="Find and book flights"
                                   style="-fx-font-size: 12px; -fx-text-fill: #888;"
                                   wrapText="true"/>
                        </VBox>

                        <!-- My Bookings -->
                        <VBox alignment="CENTER" spacing="12"
                              onMouseClicked="#goToMyBookings"
                              style="-fx-background-color: rgba(255,255,255,0.95);
                                     -fx-background-radius: 18;
                                     -fx-padding: 36 28 36 28;
                                     -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.18),12,0,0,4);"
                              prefWidth="200" prefHeight="180">
                            <Label text="📅"
                                   style="-fx-font-size: 34px;"/>
                            <Label text="My Bookings"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a2d5a;"/>
                            <Label text="View booking history"
                                   style="-fx-font-size: 12px; -fx-text-fill: #888;"
                                   wrapText="true"/>
                        </VBox>

                        <!-- Verify Ticket -->
                        <VBox alignment="CENTER" spacing="12"
                              onMouseClicked="#goToVerifyTicket"
                              style="-fx-background-color: rgba(255,255,255,0.95);
                                     -fx-background-radius: 18;
                                     -fx-padding: 36 28 36 28;
                                     -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.18),12,0,0,4);"
                              prefWidth="200" prefHeight="180">
                            <Label text="🎫"
                                   style="-fx-font-size: 34px;"/>
                            <Label text="Verify Ticket"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a2d5a;"/>
                            <Label text="Check ticket by PNR"
                                   style="-fx-font-size: 12px; -fx-text-fill: #888;"
                                   wrapText="true"/>
                        </VBox>

                    </HBox>
                </VBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>